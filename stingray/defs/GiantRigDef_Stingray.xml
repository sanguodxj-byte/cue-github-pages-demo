      <swimIdleAnim>KiiroBum_Anim_Stingray_06_Water_Idle</swimIdleAnim>
      <swimAnim>KiiroBum_Anim_Stingray_07_Water_Cruise</swimAnim>
      <swimFastAnim>KiiroBum_Anim_Stingray_07_Water_Cruise</swimFastAnim>
      <swimCycleDistance>2.20</swimCycleDistance>
      <buoyancyBobAmplitude>0.042</buoyancyBobAmplitude>
      <buoyancyBobPeriodTicks>96</buoyancyBobPeriodTicks>
      <spawnWaterWakeVfx>true</spawnWaterWakeVfx>
      <wakeScale>1.15</wakeScale>
      <wakeIntervalTicks>8</wakeIntervalTicks>
      <suppressGroundDustInWater>true</suppressGroundDustInWater>
    </aquaticLocomotion>

