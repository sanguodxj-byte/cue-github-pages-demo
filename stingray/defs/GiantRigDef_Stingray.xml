    <painImmune>true</painImmune>
    <onlyDieWhenCoreDestroyed>true</onlyDieWhenCoreDestroyed>
    <useCoupledSagittalKinematics>true</useCoupledSagittalKinematics>
    <turnSpeedDegPerTick>2.60</turnSpeedDegPerTick>
    <walkCycleDistance>1.20</walkCycleDistance>
    <runCycleDistance>1.60</runCycleDistance>
    <turnCycleAngleDeg>24</turnCycleAngleDeg>
    <portraitScaleFactor>0.34</portraitScaleFactor>

    <idleAnim>KiiroBum_Anim_Stingray_01_Land_Idle</idleAnim>
    <walkAnim>KiiroBum_Anim_Stingray_02_Land_Walk</walkAnim>
    <runAnim>KiiroBum_Anim_Stingray_03_Land_Run</runAnim>
    <turnLeftAnim>KiiroBum_Anim_Stingray_04_Land_TurnInPlace</turnLeftAnim>
    <turnRightAnim>KiiroBum_Anim_Stingray_04_Land_TurnInPlace</turnRightAnim>
    <rangedAttackAnim>KiiroBum_Anim_Stingray_09_Attack_TwinTesla</rangedAttackAnim>
    <abilityAnims>
      <li>KiiroBum_Anim_Stingray_05_Morph_LandToWater</li>
      <li>KiiroBum_Anim_Stingray_08_Morph_WaterToLand</li>
      <li>KiiroBum_Anim_Stingray_10_Skill_ChronoTeleport</li>
      <li>KiiroBum_Anim_Stingray_11_Skill_TherapyShock</li>
      <li>KiiroBum_Anim_Stingray_12_Skill_TeslaOverload</li>
    </abilityAnims>
    <downedAnim>KiiroBum_Anim_Stingray_Downed</downedAnim>
    <deathAnim>KiiroBum_Anim_Stingray_13_Mech_Hit_Downed_Death</deathAnim>

    <weaponEmitters>
      <li>
        <emitterId>twin_tesla_coils</emitterId>
        <fireMode>AlternatingOrSimultaneous</fireMode>
        <replaceVanillaMuzzleFlash>true</replaceVanillaMuzzleFlash>
        <spawnMuzzleVfxOnLaunch>true</spawnMuzzleVfxOnLaunch>
        <vfxPresetOverride>PlasmaBurst</vfxPresetOverride>
        <vfxScale>1.05</vfxScale>
        <vfxColor>(0.24, 0.95, 1.0, 0.95)</vfxColor>
        <barrels>
          <li><boneId>tesla_coil_left</boneId></li>
          <li><boneId>tesla_coil_right</boneId></li>
        </barrels>
      </li>
    </weaponEmitters>

    <aquaticLocomotion>
      <aquaticMode>Amphibious</aquaticMode>
      <canTraverseShallowWater>true</canTraverseShallowWater>
      <canTraverseChestDeepWater>true</canTraverseChestDeepWater>
      <canTraverseDeepWater>true</canTraverseDeepWater>
      <canTraverseOceanWater>true</canTraverseOceanWater>
      <canTraverseRivers>true</canTraverseRivers>
      <canTraverseMarsh>true</canTraverseMarsh>
      <waterSpeedMultiplier>1.35</waterSpeedMultiplier>
