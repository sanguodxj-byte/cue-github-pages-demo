  <!-- External GCF Reference Rig Definition for RA3 Stingray (Therapy Shock Vessel) -->
  <!-- Stored outside Kiiro Bum Meals Off Expanded per offline preview workflow -->
  <GiantCreatureFramework.GiantRigDef>
